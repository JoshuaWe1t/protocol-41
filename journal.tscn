offset_top = -190.0
offset_right = -34.0
offset_bottom = 250.0
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "[u]Сбор информации[/u]:
Опросите жильцов. Обращайте внимание на их фразы — они могут служить подсказками о том, что происходит в доме.

[u]Оценка заражения[/u]:
С помощью выданного инструментария проводите анализ воздуха и воды, чтобы отследить концентрацию спор.

[u]Локализация очага[/u]:
Выявите и зафиксируйте в журнале конкретный этаж и квартиру, откуда распространяется заражение.

[u]Идентификация угроз[/u]:
Учитывая особенность заражения на объекте может присустивовать один из трех видов монстров.

[u]Заполнение документации[/u]: 
Внесите все собранные улики, найденные аномалии и данные об угрозах в ваш служебный журнал. Вы можете покинуть объект досрочно, если все пункты расследования успешно закрыты. "
autowrap_mode = 2

[node name="Description2" type="RichTextLabel" parent="JournalUI/Pages/PagePlayer2"]

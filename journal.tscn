theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Движение влево/вправо

Взаимодействие с дверьми/лифтом

Использование предметов из инвентаря

Открыть/закрыть журнал оперативника"
autowrap_mode = 2


theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "После истечения таймера вы обязаны отметить в журнале всё, что успели выяснить. За абсолютно верный отчет вы получите очки для улучшения экипировки.  

[b]Предупреждение:[/b] 

Любая ошибка в Акте обследования приведет к вашему переводу в статус испытуемого на объекте по исследованию аномалий, а все накопленные улучшения будут сброшены."
autowrap_mode = 2


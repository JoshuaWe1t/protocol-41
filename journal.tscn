theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "[b]Кому[/b]: Оперативному сотруднику.

[b]Легенда[/b]: Участковый инспектор полиции.

[b]Локация[/b]: Старая трехэтажная хрущевка.

Поступил сигнал о предполагаемом биологическом заражении жилого дома спорами О-41. У вас есть строго ограниченное время на проведение осмотра трех этажей здания. 

[u]Ваша задача[/u] — провести скрытый анализ объекта, собрать данные и корректно заполнить Акт обследования, не вызывая подозрений у гражданских."
autowrap_mode = 2

[node name="Description2" type="Label" parent="JournalUI/Pages/PagePlayer"]
